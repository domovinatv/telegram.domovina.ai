# Kopiraj u .dev.vars (gitignoran). U produkciji: npx wrangler secret put <IME>
# Token bota (BotFather) koji objavljuje u kanale podcasta
TELEGRAM_BOT_TOKEN=
# Bearer za /podcasts/* (petlja i provisioner na Macu ga čitaju iz .dev.vars)
API_TOKEN=
# Tajna koju Telegram šalje u X-Telegram-Bot-Api-Secret-Token na /telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
